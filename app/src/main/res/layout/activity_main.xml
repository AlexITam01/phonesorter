<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Photo Sorter — local only"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPrivacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Scan photos" />

        <Button
            android:id="@+id/btnExportPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Export plan (plan.csv / plan.json)" />

        <Button
            android:id="@+id/btnResume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resume from saved plan" />

        <!-- v0.2.0: green determinate progress bar. Numerals are in
             tvProgress directly above it, e.g. "Classified 12 / 48"
             and "Copying 12 / 48". max/progress are set from the
             ViewModel (progressTotal / progressDone). -->
        <ProgressBar
            android:id="@+id/pbProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="1"
            android:progress="0"
            android:progressTint="#2E7D32"
            android:progressBackgroundTint="#C8E6C9"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <!-- v0.4: Colab path — the two blue buttons Alex asked for.
             They sit directly below the progress bar / tvProgress,
             in the fourth row, split side by side. Each button is
             layout_weight="1" with layout_width="0dp" and a 4dp
             margin, so each one is a little less than half the
             full-width bar buttons above. Blue #1565C0, white text.
             Button 1 builds thumbnails.zip in a background worker
             and opens the Colab notebook; button 2 imports the
             Colab plan.csv and sorts from it in a background
             worker. Both workers survive rotation / app kill /
             reboot (see ColabUploadWorker / ColabSortWorker). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnUploadColab"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#1565C0"
                android:text="Upload to notebook"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnSortColab"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:backgroundTint="#1565C0"
                android:text="Sort"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvColab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Categories — tap to view, Approve to move/delete"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategories"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvSelected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="No category selected" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPhotos"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nothing is moved or deleted until you tap Approve for a category. NSFW explicit captions are always shown as [redacted]. Cloud upload is OFF by default — see README."
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
