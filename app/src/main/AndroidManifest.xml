<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Photo Sorter. Core sort is local only (no network use).
      v0.4 adds INTERNET for the opt-in Colab path only — the two
      blue buttons. See CloudUpload.kt / README.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 12 and below: -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- v0.4: INTERNET is ONLY for the opt-in Colab path (the two
         blue buttons). The local Scan path still runs fully
         on-device with no network use. Tapping "Upload to
         notebook" is the explicit opt-in — nothing uploads on
         its own, and the button opens the Colab notebook URL. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- v0.3.0: WorkManager foreground workers run as a foreground
         service while sorting, and BootReceiver resumes an
         unfinished scan after a reboot. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- v0.3.1 fix: Android 14 (targetSdk 34) requires the specific
         foreground-service type permission for dataSync workers.
         v0.3.0 declared only FOREGROUND_SERVICE, so setForeground()
         in SortWorker/MoveWorker threw and crashed the app on Scan. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Photo Sorter"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhotoSorter">
        <!-- v0.3.0: on boot, re-enqueue a scan that was in
             progress when the phone shut down (see BootReceiver).
             Does nothing if no scan was in flight. -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
